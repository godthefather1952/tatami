{
  "name": "MotionForge",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "MotionForge",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "remoteEnv": {
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "HF_HUB_DISABLE_IMPLICIT_TOKEN": "1",
    "DO_NOT_TRACK": "1"
  }
}
